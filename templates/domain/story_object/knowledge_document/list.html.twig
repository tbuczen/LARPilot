{% extends 'backoffice/larp/base.html.twig' %}
{% import 'macros/ui_components.html.twig' as ui %}

{% block larp_title %}{{ 'knowledge_document.list'|trans }} - {{ larp.title }}{% endblock %}

{% block larp_content %}
    <div class="card mt-4">
        {% set actions %}
            {{ ui.primary_button('create', path('backoffice_larp_knowledge_modify', { larp: larp.id }), 'bi-plus-circle') }}
        {% endset %}
        {{ ui.card_header('knowledge_document.list', actions) }}
        <div class="card-body p-0">
            {% include 'includes/filter_form.html.twig' with { form: filterForm } %}

            {% if documents is not empty %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                        <tr>
                            {% include 'includes/sort_th.html.twig' with { field: 'title', label: 'title'|trans } %}
                            {% include 'includes/sort_th.html.twig' with { field: 'category', label: 'knowledge_document.category'|trans } %}
                            <th>{{ 'knowledge_document.visibility'|trans }}</th>
                            {% include 'includes/sort_th.html.twig' with { field: 'updated', label: 'updated_at'|trans } %}
                            <th>{{ 'actions'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for document in documents %}
                            <tr>
                                <td>
                                    <a href="{{ path('backoffice_larp_knowledge_modify', { larp: larp.id, document: document.id }) }}">
                                        {{ document.title }}
                                    </a>
                                </td>
                                <td>
                                    {% if document.category %}
                                        <span class="badge bg-secondary">{{ ('knowledge_document.category.' ~ document.category)|trans }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if document.isPublic %}
                                        <span class="badge bg-success">{{ 'knowledge_document.public'|trans }}</span>
                                    {% else %}
                                        {% set charCount = document.visibleToCharacters|length %}
                                        {% set factionCount = document.visibleToFactions|length %}
                                        {% if charCount > 0 or factionCount > 0 %}
                                            <small class="text-muted">
                                                {% if charCount > 0 %}{{ charCount }} {{ 'knowledge_document.characters'|trans }}{% endif %}
                                                {% if charCount > 0 and factionCount > 0 %}, {% endif %}
                                                {% if factionCount > 0 %}{{ factionCount }} {{ 'knowledge_document.factions'|trans }}{% endif %}
                                            </small>
                                        {% else %}
                                            <span class="badge bg-warning">{{ 'knowledge_document.restricted'|trans }}</span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                                <td>{{ document.updatedAt|date('Y-m-d H:i') }}</td>
                                <td>
                                    {{ ui.delete_button(document.id, document.title, path('backoffice_larp_knowledge_delete', { larp: larp.id, document: document.id })) }}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                {% if documents.pageCount > 1 %}
                    <div class="card-footer">
                        {{ knp_pagination_render(documents) }}
                    </div>
                {% endif %}
            {% else %}
                {{ ui.empty_state('knowledge_document.empty_list', 'bi-book') }}
            {% endif %}
        </div>
    </div>

    {# Unified delete modal with Stimulus controller #}
    {% include 'includes/delete_modal.html.twig' %}
{% endblock %}
