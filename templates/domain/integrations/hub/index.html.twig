{% extends 'backoffice/larp/base.html.twig' %}

{% import 'macros/ui_components.html.twig' as ui %}

{% block larp_title %}{{ 'integration_hub.title'|trans }} - {{ larp.title }}{% endblock %}

{% block larp_content %}
    {{ ui.page_header('integration_hub.title') }}
    <p class="text-muted">{{ 'integration_hub.intro'|trans }}</p>

    {% if cards is empty %}
        {{ ui.empty_state('integration_hub.empty', 'bi-plugin') }}
    {% else %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            {% for card in cards %}
                <div class="col">
                    {% include 'domain/integrations/hub/_card.html.twig' with {card: card, larp: larp} only %}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% include 'includes/delete_modal.html.twig' %}
{% endblock %}
