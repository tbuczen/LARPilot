{% extends 'backoffice/larp/base.html.twig' %}

{% import 'macros/ui_components.html.twig' as ui %}
{% import _self as import %}

{% macro entry_label(entry) %}
    {% set title = entry.title is empty ? ('browser.type.' ~ entry.type)|trans({}, 'miro') : entry.title %}
    <div class="d-flex flex-wrap align-items-center gap-1">
        <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer" class="fw-semibold text-break">{{ title }}</a>
        <span class="badge bg-light text-dark border">{{ ('browser.type.' ~ entry.type)|trans({}, 'miro') }}</span>
        {% for tag in entry.tags %}
            <span class="badge text-bg-secondary">{{ tag }}</span>
        {% endfor %}
    </div>
{% endmacro %}

{% macro target_label(target) %}
    <span class="text-break">{{ target.title }}</span>
    <span class="badge bg-light text-dark border">{{ target.type.value|trans }}</span>
    {% if target.isPlanned() %}
        <span class="badge text-bg-success">{{ 'import.new'|trans({}, 'miro') }}</span>
    {% endif %}
{% endmacro %}

{% macro relation_label(suggestion) %}
    {{ _self.target_label(suggestion.from) }}
    <span class="text-muted">—
        {% if suggestion.relationType %}{{ ('import.relation_type.' ~ suggestion.relationType.value)|trans({}, 'miro') }}{% else %}{{ suggestion.entry.text|default('import.no_caption'|trans({}, 'miro')) }}{% endif %}
    →</span>
    {{ _self.target_label(suggestion.to) }}
{% endmacro %}

{% block larp_title %}{{ 'import.title'|trans({}, 'miro') }} - {{ board.title }} - {{ larp.title }}{% endblock %}

{% block larp_content %}
    {% set boardPath = path('backoffice_larp_integration_miro_browser_show', {larp: larp.id, source: board.id}) %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item">{{ board.integration.provider.label }}</li>
            <li class="breadcrumb-item text-break"><a href="{{ boardPath }}">{{ board.title }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'import.title'|trans({}, 'miro') }}</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center mb-3">
        <h1 class="mb-0 text-break">{{ 'import.title'|trans({}, 'miro') }}</h1>
        <div class="d-flex flex-wrap gap-2">
            {{ ui.back_button(boardPath) }}
        </div>
    </div>

    <p class="text-muted">{{ 'import.intro'|trans({}, 'miro') }}</p>

    {% if problem %}
        <div class="alert alert-warning" data-miro-problem="{{ problem }}">
            <i class="bi bi-exclamation-triangle"></i>
            {{ ('browser.problem.' ~ problem)|trans({'%seconds%': retryAfterSeconds}, 'miro') }}
        </div>
    {% endif %}

    {% if plan %}
        {% set changes = plan.changes %}
        {% if plan.unchangedCount > 0 %}
            <p class="small text-muted" data-miro-import-unchanged="{{ plan.unchangedCount }}">
                {{ 'import.unchanged'|trans({'%count%': plan.unchangedCount}, 'miro') }}
            </p>
        {% endif %}

        {% if changes is empty %}
            <div class="alert alert-success" data-miro-import-empty>
                <i class="bi bi-check-circle"></i>
                {{ 'import.no_changes'|trans({}, 'miro') }}
            </div>
        {% else %}
            <form method="post" name="miro_board_import" action="{{ path('backoffice_larp_integration_miro_import_apply', {larp: larp.id, source: board.id}) }}" data-controller="select-all">
                <input type="hidden" name="_token" value="{{ csrf_token('miro_board_import_' ~ board.id) }}">
                <div class="card mb-3">
                    <div class="card-header">
                        <h2 class="h5 mb-0">{{ 'import.changes'|trans({'%count%': changes|length}, 'miro') }}</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="text-nowrap">
                                        <input type="checkbox" class="form-check-input" data-select-all-target="toggle" data-action="select-all#toggle"
                                               aria-label="{{ 'import.select_all'|trans({}, 'miro') }}" title="{{ 'import.select_all'|trans({}, 'miro') }}">
                                    </th>
                                    <th scope="col">{{ 'import.column.element'|trans({}, 'miro') }}</th>
                                    <th scope="col">{{ 'import.column.suggestion'|trans({}, 'miro') }}</th>
                                    <th scope="col">{{ 'import.column.before'|trans({}, 'miro') }}</th>
                                    <th scope="col">{{ 'import.column.after'|trans({}, 'miro') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for suggestion in changes %}
                                    {% set rowId = 'miro-import-row-' ~ loop.index %}
                                    <tr data-miro-import-row="{{ suggestion.entry.externalId }}" data-miro-import-action="{{ suggestion.action.value }}">
                                        <td>
                                            <input type="checkbox" class="form-check-input" name="rows[]" value="{{ suggestion.token }}" id="{{ rowId }}"
                                                   data-select-all-target="item"
                                                   aria-label="{{ ('import.action.' ~ suggestion.action.value)|trans({}, 'miro') }}: {{ suggestion.entry.title }}">
                                        </td>
                                        <td style="min-width: 12rem">{{ import.entry_label(suggestion.entry) }}</td>
                                        <td class="text-nowrap">
                                            <label for="{{ rowId }}" class="d-flex flex-column gap-1">
                                                <span class="badge text-bg-{{ suggestion.action.value == 'link' ? 'primary' : 'success' }} align-self-start">{{ ('import.action.' ~ suggestion.action.value)|trans({}, 'miro') }}</span>
                                                {% if suggestion.confidence.value == 'low' %}
                                                    <span class="small text-muted" data-miro-import-confidence="low">{{ 'import.confidence.low'|trans({}, 'miro') }}</span>
                                                {% endif %}
                                            </label>
                                        </td>
                                        <td style="min-width: 10rem">
                                            {% if suggestion.action.value == 'link' %}
                                                {% set miroLinkCount = suggestion.target.storyObject.externalReferences|filter(reference => reference.provider.value == 'miro')|length %}
                                                <div>{{ import.target_label(suggestion.target) }}</div>
                                                <div class="small text-muted">{{ 'import.miro_links'|trans({'%count%': miroLinkCount}, 'miro') }}</div>
                                            {% else %}
                                                <span class="text-muted">{{ 'import.not_in_larpilot'|trans({}, 'miro') }}</span>
                                            {% endif %}
                                        </td>
                                        <td style="min-width: 12rem">
                                            {% if suggestion.action.value == 'create_relation' %}
                                                {{ import.relation_label(suggestion) }}
                                            {% else %}
                                                <div>{{ import.target_label(suggestion.target) }}</div>
                                                <div class="small text-muted">{{ 'import.linked_to_item'|trans({}, 'miro') }}</div>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-between align-items-sm-center">
                            <span class="small text-muted">{{ 'import.confirm_hint'|trans({}, 'miro') }}</span>
                            <div class="d-flex justify-content-end gap-2">
                                {{ ui.back_button(boardPath, 'cancel') }}
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg"></i>{{ 'import.apply'|trans({}, 'miro') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        {% endif %}

        {% if plan.membershipHints is not empty %}
            <div class="card mb-3" data-miro-import-memberships>
                <div class="card-header">
                    <h2 class="h5 mb-0">{{ 'import.memberships'|trans({}, 'miro') }}</h2>
                </div>
                <div class="card-body">
                    <p class="small text-muted">{{ 'import.memberships_hint'|trans({}, 'miro') }}</p>
                    <ul class="list-group">
                        {% for hint in plan.membershipHints %}
                            <li class="list-group-item d-flex flex-wrap align-items-center gap-2" data-miro-import-membership="{{ hint.characterEntry.externalId }}">
                                {{ import.target_label(hint.character) }}
                                <span class="text-muted">→ {{ 'import.member_of'|trans({}, 'miro') }}</span>
                                {{ import.target_label(hint.faction) }}
                                {% if hint.alreadyMember %}
                                    <span class="badge text-bg-light border">{{ 'import.already_member'|trans({}, 'miro') }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}

        {% set notImportable = plan.notImportable %}
        {% if notImportable is not empty %}
            <div class="card mb-3" data-miro-import-not-importable>
                <div class="card-header">
                    <h2 class="h5 mb-0">{{ 'import.not_importable'|trans({'%count%': notImportable|length}, 'miro') }}</h2>
                </div>
                <ul class="list-group list-group-flush">
                    {% for suggestion in notImportable %}
                        <li class="list-group-item" data-miro-import-skipped="{{ suggestion.entry.externalId }}" data-miro-import-action="{{ suggestion.action.value }}">
                            <div class="d-flex flex-column flex-md-row gap-2 justify-content-between">
                                <div class="min-w-0">
                                    {{ import.entry_label(suggestion.entry) }}
                                    {% if suggestion.from and suggestion.to %}
                                        <div class="small mt-1">{{ import.relation_label(suggestion) }}</div>
                                    {% endif %}
                                </div>
                                <div class="small flex-shrink-0">
                                    <span class="badge text-bg-warning">{{ ('import.action.' ~ suggestion.action.value)|trans({}, 'miro') }}</span>
                                    <div class="text-muted">
                                        {% if suggestion.reason %}
                                            {{ ('import.reason.' ~ suggestion.reason)|trans({}, 'miro') }}
                                        {% else %}
                                            {{ ('import.reason.' ~ suggestion.action.value)|trans({}, 'miro') }}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
