{% extends 'backoffice/larp/base.html.twig' %}

{% import 'macros/ui_components.html.twig' as ui %}

{% block larp_title %}{{ 'channels.title'|trans({}, 'discord') }} - {{ larp.title }}{% endblock %}

{% macro target_type_options(targetTypes, selectedType) %}
    <option value="">{{ 'channels.no_story_type'|trans({}, 'discord') }}</option>
    {% for targetType in targetTypes %}
        <option value="{{ targetType.value }}" {% if selectedType is same as(targetType) %}selected{% endif %}>
            {{ ('story_type.' ~ targetType.value)|trans({}, 'discord') }}
        </option>
    {% endfor %}
{% endmacro %}

{% block larp_content %}
    <div class="card mt-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">{{ 'channels.title'|trans({}, 'discord') }}</h2>
                <div class="d-flex gap-2">
                    {{ ui.back_button(path('backoffice_larp_integration_settings', { larp: larp.id })) }}
                </div>
            </div>
            <p class="text-muted mb-0 mt-2">
                {{ 'channels.intro'|trans({ '%guild%': integration.config.guildName ?? integration.externalAccountId }, 'discord') }}
            </p>
        </div>
        <form method="post"
              name="discord_channels"
              action="{{ path('backoffice_larp_discord_channels_save', { larp: larp.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">
            <div class="card-body p-0">
                {% if channels is not empty %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>{{ 'channels.watch'|trans({}, 'discord') }}</th>
                                    <th>{{ 'channels.channel'|trans({}, 'discord') }}</th>
                                    <th>{{ 'channels.visibility'|trans({}, 'discord') }}</th>
                                    <th>{{ 'channels.default_story_type'|trans({}, 'discord') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for channel in channels %}
                                    {% set fieldPrefix = 'channels[' ~ channel.id ~ ']' %}
                                    {% set watched = sourceConfigs[channel.id] is defined %}
                                    {% set sourceConfig = sourceConfigs[channel.id] ?? defaultSourceConfig %}
                                    <tr data-channel-id="{{ channel.id }}">
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       role="switch"
                                                       id="discord-watch-{{ channel.id }}"
                                                       name="{{ fieldPrefix }}[watched]"
                                                       value="1"
                                                       {% if watched %}checked{% endif %}>
                                                <label class="visually-hidden" for="discord-watch-{{ channel.id }}">
                                                    {{ 'channels.watch'|trans({}, 'discord') }} {{ channel.name }}
                                                </label>
                                            </div>
                                        </td>
                                        <td>
                                            {% if channel.forum %}
                                                <i class="bi bi-chat-square-text" title="{{ 'channels.forum'|trans({}, 'discord') }}"></i>
                                            {% else %}
                                                <i class="bi bi-hash" title="{{ 'channels.text_channel'|trans({}, 'discord') }}"></i>
                                            {% endif %}
                                            {{ channel.name ?? channel.id }}
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm"
                                                    name="{{ fieldPrefix }}[visibility]"
                                                    aria-label="{{ 'channels.visibility'|trans({}, 'discord') }}">
                                                {% for visibility in visibilities %}
                                                    <option value="{{ visibility.value }}" {% if sourceConfig.visibility is same as(visibility) %}selected{% endif %}>
                                                        {{ ('visibility.' ~ visibility.value)|trans({}, 'discord') }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm"
                                                    name="{{ fieldPrefix }}[defaultTargetType]"
                                                    aria-label="{{ 'channels.default_story_type'|trans({}, 'discord') }}">
                                                {{ _self.target_type_options(targetTypes, sourceConfig.defaultTargetType) }}
                                            </select>
                                        </td>
                                    </tr>
                                    {% if channel.forum and channel.availableTags is not empty %}
                                        <tr>
                                            <td></td>
                                            <td colspan="3">
                                                <div class="small text-muted mb-2">{{ 'channels.forum_tags'|trans({}, 'discord') }}</div>
                                                <table class="table table-sm mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>{{ 'channels.forum_tag'|trans({}, 'discord') }}</th>
                                                            <th>{{ 'channels.larp_tag'|trans({}, 'discord') }}</th>
                                                            <th>{{ 'channels.story_type'|trans({}, 'discord') }}</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% for forumTag in channel.availableTags %}
                                                            {% set tagPrefix = fieldPrefix ~ '[forumTags][' ~ forumTag.id ~ ']' %}
                                                            {% set tagMapping = sourceConfig.forumTagMapping(forumTag.id) %}
                                                            <tr data-forum-tag-id="{{ forumTag.id }}">
                                                                <td>{{ forumTag.emojiName }} {{ forumTag.name }}</td>
                                                                <td>
                                                                    <select class="form-select form-select-sm"
                                                                            name="{{ tagPrefix }}[tagId]"
                                                                            aria-label="{{ 'channels.larp_tag'|trans({}, 'discord') }}">
                                                                        <option value="">{{ 'channels.no_tag'|trans({}, 'discord') }}</option>
                                                                        {% for larpTag in larpTags %}
                                                                            <option value="{{ larpTag.id }}" {% if tagMapping.tagId == larpTag.id.toRfc4122 %}selected{% endif %}>
                                                                                {{ larpTag.title }}
                                                                            </option>
                                                                        {% endfor %}
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <select class="form-select form-select-sm"
                                                                            name="{{ tagPrefix }}[targetType]"
                                                                            aria-label="{{ 'channels.story_type'|trans({}, 'discord') }}">
                                                                        {{ _self.target_type_options(targetTypes, tagMapping.targetType) }}
                                                                    </select>
                                                                </td>
                                                            </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted p-3 mb-0">{{ 'channels.empty'|trans({}, 'discord') }}</p>
                {% endif %}
            </div>
            <div class="card-footer">
                <p class="small text-muted">{{ 'channels.privacy_note'|trans({}, 'discord') }}</p>
                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('backoffice_larp_integration_settings', { larp: larp.id }) }}" class="btn btn-outline-secondary">
                        {{ 'cancel'|trans }}
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i>{{ 'channels.save'|trans({}, 'discord') }}
                    </button>
                </div>
            </div>
        </form>
    </div>
{% endblock %}
