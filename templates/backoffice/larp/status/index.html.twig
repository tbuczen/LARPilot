{% extends 'backoffice/larp/base.html.twig' %}

{% block title %}{{ 'larp.status.management'|trans }} - {{ larp.title }}{% endblock %}

{% block larp_content %}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">{{ 'larp.status.current'|trans }}</h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <span class="badge text-bg-{{ currentStatus.value == 'DRAFT' ? 'secondary' : (currentStatus.value == 'CONFIRMED' ? 'success' : 'primary') }} fs-5 me-3">
                        {{ currentStatus.label|trans }}
                    </span>
                    <div>
                        <h6 class="mb-0">{{ currentStatus.label|trans }}</h6>
                        <small class="text-muted">{{ currentStatus.description|trans }}</small>
                    </div>
                </div>

                {% if availableTransitions|length > 0 %}
                <div class="mt-4">
                    <h6>{{ 'larp.status.available_transitions'|trans }}</h6>
                    <div class="d-flex flex-wrap gap-2">
                        {% for transition in availableTransitions %}
                        {% if transition.canExecute %}
                        <form method="post" action="{{ path('backoffice_larp_status_transition', {larp: larp.id, transitionName: transition.name}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('larp_transition_' ~ larp.id) }}">
                            <button type="submit" 
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="return confirm('{{ 'larp.status.confirm_transition'|trans({'%transition%': transition.label|trans}) }}')">
                                {{ transition.label|trans }}
                                {% if transition.to %}
                                    <i class="bi bi-arrow-right"></i>
                                    <span class="badge text-bg-secondary">{{ ('larp.status.' ~ transition.to|lower)|trans }}</span>
                                {% endif %}
                            </button>
                        </form>
                        {% else %}
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                {{ transition.label|trans }}
                                {% if transition.to %}
                                    <i class="bi bi-arrow-right"></i>
                                    <span class="badge text-bg-secondary">{{ ('larp.status.' ~ transition.to|lower)|trans }}</span>
                                {% endif %}
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="visually-hidden">{{ 'larp.status.requirement.toggle_details'|trans }}</span>
                            </button>
                            <ul class="dropdown-menu">
                                <li><h6 class="dropdown-header">{{ 'larp.status.requirement.label'|trans }}</h6></li>
                                {% for error in transition.validationErrors %}
                                <li><span class="dropdown-item-text text-danger"><i class="bi bi-exclamation-circle"></i> {{ error }}</span></li>
                                {% endfor %}
                            </ul>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>
                {% elseif not canCancel %}
                <div class="alert alert-info">
                    {{ 'larp.status.no_transitions'|trans }}
                </div>
                {% endif %}
            </div>
        </div>

        <div class="card mt-4 border-danger">
            <div class="card-header">
                <h5 class="card-title mb-0">{{ 'larp.status.danger_zone'|trans }}</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <h6 class="mb-1">{{ 'larp.cancel.title'|trans }}</h6>
                        <small class="text-muted">
                            {{ canCancel ? 'larp.cancel.consequences'|trans : 'larp.cancel.not_available'|trans }}
                        </small>
                    </div>
                    {% if canCancel %}
                        <button type="button" class="btn btn-warning text-nowrap" data-bs-toggle="modal" data-bs-target="#cancelLarpModal">
                            <i class="bi bi-x-octagon"></i>{{ 'larp.cancel.button'|trans }}
                        </button>
                    {% endif %}
                </div>
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <h6 class="mb-1">{{ 'larp.delete.title'|trans }}</h6>
                        <small class="text-muted">
                            {{ canDelete ? 'larp.delete.warning'|trans : 'larp.delete.draft_only'|trans }}
                        </small>
                    </div>
                    {% if canDelete %}
                        <button type="button" class="btn btn-outline-danger text-nowrap" data-bs-toggle="modal" data-bs-target="#deleteLarpModal-{{ larp.id }}">
                            <i class="bi bi-trash"></i>{{ 'larp.delete.button'|trans }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h5 class="card-title mb-0">{{ 'larp.properties'|trans }}</h5>
            </div>
            <div class="card-body">
                {{ form_start(propertiesForm, {'action': path('backoffice_larp_status_update_properties', {'larp': larp.id})}) }}

                {{ form_row(propertiesForm.title) }}

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(propertiesForm.startDate) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(propertiesForm.endDate) }}
                    </div>
                </div>

                {{ form_row(propertiesForm.location) }}

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(propertiesForm.maxCharacterChoices) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(propertiesForm.setting) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(propertiesForm.type) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(propertiesForm.characterSystem) }}
                    </div>
                </div>

                {{ form_row(propertiesForm.description) }}

                <hr class="my-4">
                <h6 class="mb-3">{{ 'larp.status.social_visual_settings'|trans }}</h6>

                {{ form_row(propertiesForm.headerImageFile) }}

                {% if larp.headerImage %}
                    <div class="mb-3">
                        <label class="form-label">{{ 'larp.status.current_header_image'|trans }}</label>
                        <div>
                            <img src="{{ larp.headerImagePath }}" alt="{{ 'larp.status.current_header_image'|trans }}" class="img-fluid" style="max-height: 200px;">
                        </div>
                    </div>
                {% endif %}

                {{ form_row(propertiesForm.discordServerUrl) }}
                {{ form_row(propertiesForm.facebookEventUrl) }}

                {{ form_row(propertiesForm.submit) }}

                {{ form_end(propertiesForm) }}
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="card-title mb-0">{{ 'larp.status.workflow'|trans }}</h6>
            </div>
            <div class="card-body">
                <div class="workflow-diagram">
                    {% for status in allStatuses %}
                    <div class="workflow-step {{ status == currentStatus ? 'active' : '' }}">
                        <span class="badge text-bg-{{ status.value == currentStatus.value ? 'primary' : 'secondary' }}">
                            {{ status.label|trans }}
                        </span>
                        <small class="d-block mt-1">{{ status.description|trans }}</small>
                    </div>
                    {% if not loop.last %}
                    <div class="workflow-arrow">
                        <i class="bi bi-arrow-down"></i>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h6 class="card-title mb-0">{{ 'larp.status.visibility'|trans }}</h6>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <strong>{{ 'larp.status.visible_everyone'|trans }}:</strong>
                    <span class="badge text-bg-{{ currentStatus.isVisibleForEveryone() ? 'success' : 'secondary' }}">
                        {{ currentStatus.isVisibleForEveryone() ? 'yes'|trans : 'no'|trans }}
                    </span>
                </div>
                <div>
                    <strong>{{ 'larp.status.visible_organizers'|trans }}:</strong>
                    <span class="badge text-bg-{{ currentStatus.isVisibleForOrganizers() ? 'success' : 'secondary' }}">
                        {{ currentStatus.isVisibleForOrganizers() ? 'yes'|trans : 'no'|trans }}
                    </span>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h6 class="card-title mb-0">{{ 'larp.status.requirements'|trans }}</h6>
            </div>
            <div class="card-body">
                <div class="accordion" id="requirementsAccordion">
                    {# To Publish Requirements #}
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button {{ currentStatus.value in ['DRAFT', 'WIP'] ? '' : 'collapsed' }}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#publishRequirements">
                                <i class="bi bi-upload me-2"></i> {{ 'larp.status.requirement.publish'|trans }}
                            </button>
                        </h2>
                        <div id="publishRequirements"
                             class="accordion-collapse collapse {{ currentStatus.value in ['DRAFT', 'WIP'] ? 'show' : '' }}"
                             data-bs-parent="#requirementsAccordion">
                            <div class="accordion-body">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2">
                                        <i class="bi {{ larp.location ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }}"></i>
                                        {{ 'larp.status.requirement.location'|trans }}
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi {{ larp.description ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }}"></i>
                                        {{ 'larp.status.requirement.description'|trans }}
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi {{ larp.startDate ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }}"></i>
                                        {{ 'larp.status.requirement.start_date'|trans }}
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi {{ larp.endDate ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }}"></i>
                                        {{ 'larp.status.requirement.end_date'|trans }}
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    {# Open for Inquiries Requirements #}
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#inquiriesRequirements">
                                <i class="bi bi-people me-2"></i> {{ 'larp.status.requirement.inquiries'|trans }}
                            </button>
                        </h2>
                        <div id="inquiriesRequirements"
                             class="accordion-collapse collapse"
                             data-bs-parent="#requirementsAccordion">
                            <div class="accordion-body">
                                <p class="text-muted small mb-2">{{ 'larp.status.requirement.all_publish_plus'|trans }}</p>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2">
                                        <i class="bi {{ larp.characters|length > 0 ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }}"></i>
                                        {{ 'larp.status.requirement.has_character'|trans }}
                                        {% if larp.characters|length > 0 %}
                                            <span class="badge bg-secondary ms-1">{{ larp.characters|length }}</span>
                                        {% endif %}
                                    </li>
                                    <li class="mb-2">
                                        {% set charactersWithoutDesc = larp.characters|filter(c => not c.description) %}
                                        <i class="bi {{ charactersWithoutDesc|length == 0 and larp.characters|length > 0 ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }}"></i>
                                        {{ 'larp.status.requirement.characters_described'|trans }}
                                        {% if charactersWithoutDesc|length > 0 %}
                                            <span class="badge bg-warning ms-1">{{ 'larp.status.requirement.missing'|trans({'%count%': charactersWithoutDesc|length}) }}</span>
                                        {% endif %}
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    {# Confirm Event Requirements #}
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#confirmRequirements">
                                <i class="bi bi-check2-all me-2"></i> {{ 'larp.status.requirement.confirm'|trans }}
                            </button>
                        </h2>
                        <div id="confirmRequirements"
                             class="accordion-collapse collapse"
                             data-bs-parent="#requirementsAccordion">
                            <div class="accordion-body">
                                <p class="text-muted small mb-2">{{ 'larp.status.requirement.all_inquiries_plus'|trans }}</p>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2">
                                        {% set unassignedChars = larp.characters|filter(c => c.larpParticipant is null) %}
                                        <i class="bi {{ unassignedChars|length == 0 and larp.characters|length > 0 ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }}"></i>
                                        {{ 'larp.status.requirement.characters_assigned'|trans }}
                                        {% if unassignedChars|length > 0 %}
                                            <span class="badge bg-warning ms-1">{{ 'larp.status.requirement.unassigned'|trans({'%count%': unassignedChars|length}) }}</span>
                                        {% endif %}
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% if canCancel %}
    {% include 'backoffice/larp/status/_cancel_modal.html.twig' %}
{% endif %}
{% if canDelete %}
    {% include 'backoffice/larp/partials/_delete_larp_modal.html.twig' %}
{% endif %}

<style>
.workflow-diagram {
    text-align: center;
}

.workflow-step {
    margin: 10px 0;
    padding: 10px;
    border-radius: 5px;
    transition: background-color 0.3s;
}

.workflow-step.active {
    background-color: rgba(33, 150, 243, 0.12);
    border: 2px solid #2196f3;
}

.workflow-arrow {
    color: #666;
    margin: 5px 0;
}

.btn-group .dropdown-menu {
    min-width: 300px;
}
</style>
{% endblock %}